# arduino-cli build output. --export-binaries drops ~22 MB of .elf/.map here.
build/

# Python
__pycache__/
*.py[cod]

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Built firmware is never committed. release.yml builds it and attaches it to
# the release; pages.yml pulls those images back in when it deploys the site, so
# the hosted Badge Studio still serves them same-origin. Build locally as much
# as you like - the results just stay out of git.
firmware/*.bin
